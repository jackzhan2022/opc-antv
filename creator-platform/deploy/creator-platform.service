[Unit]
Description=SinX Creator Platform backend
Wants=network-online.target docker.service
After=network-online.target docker.service sinx-platform.service

[Service]
Type=simple
User=creator-platform
Group=creator-platform
WorkingDirectory=/opt/creator-platform
EnvironmentFile=/etc/creator-platform/application.env
ExecStart=/usr/bin/java -Xms48m -Xmx192m -XX:MaxMetaspaceSize=160m -XX:+ExitOnOutOfMemoryError -jar /opt/creator-platform/current/app.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SuccessExitStatus=143
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=creator-platform
ReadWritePaths=/var/lib/creator-platform
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
