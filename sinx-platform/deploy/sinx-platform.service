[Unit]
Description=SinX Platform backend
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=sinx-platform
Group=sinx-platform
WorkingDirectory=/opt/sinx-platform
EnvironmentFile=/etc/sinx-platform/application.env
ExecStart=/usr/bin/java -Xms64m -Xmx256m -XX:MaxMetaspaceSize=192m -XX:+ExitOnOutOfMemoryError -jar /opt/sinx-platform/current/app.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SuccessExitStatus=143
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=sinx-platform
ReadWritePaths=/var/lib/sinx-platform
MemoryMax=640M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
